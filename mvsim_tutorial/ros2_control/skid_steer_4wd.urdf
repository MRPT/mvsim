<?xml version="1.0"?>
<!--
  Example URDF of a 4-wheel skid-steer robot, with the REP-105 frames:
  base_footprint on the ground, and base_link above it (at the wheel axles).
  Its <ros2_control> block names another hardware plugin (as for Gazebo, a
  mock or real hardware), but MVSim binds its joints to the simulated ones by
  name.

  The MVSim vehicle definition is generated from it with mvsim-urdf2xml, see
  ../urdf2xml/skid_steer_4wd_mapping.yaml
  Used by demo_ros2_control.launch.py with vehicle:=skid_steer_4wd
-->
<robot name="skid_steer_4wd">
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><box size="0.8 0.44 0.2"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.1"/>
      <geometry><box size="0.8 0.44 0.2"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1"/>
      <mass value="40.0"/>
      <inertia ixx="0.78" ixy="0" ixz="0" iyy="2.27" iyz="0" izz="2.78"/>
    </inertial>
  </link>

  <!-- Wheels: continuous joints about +Y -->
  <link name="front_left_wheel_link">
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
    </collision>
    <inertial><mass value="3.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.034" iyz="0" izz="0.02"/></inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_left_wheel_link"/>
    <origin xyz="0.25 0.3 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_wheel_link">
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
    </collision>
    <inertial><mass value="3.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.034" iyz="0" izz="0.02"/></inertial>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_right_wheel_link"/>
    <origin xyz="0.25 -0.3 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_left_wheel_link">
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
    </collision>
    <inertial><mass value="3.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.034" iyz="0" izz="0.02"/></inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_left_wheel_link"/>
    <origin xyz="-0.25 0.3 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_right_wheel_link">
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
    </collision>
    <inertial><mass value="3.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.034" iyz="0" izz="0.02"/></inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_right_wheel_link"/>
    <origin xyz="-0.25 -0.3 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 2D lidar -->
  <link name="laser"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser"/>
    <origin xyz="0.3 0 0.25" rpy="0 0 0"/>
  </joint>

  <ros2_control name="MockSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
