<mvsim_world version="1.0">
	<!--
	  A single-storey home (12 x 9 m) with a living room, a kitchen with dining
	  area, a hallway, a bedroom and a bathroom. There are two loops: living
	  room, kitchen and hallway; and hallway, bedroom and bathroom.

	  Floor plan (x to the right, y up, meters):

	   y=9 +===========+==+========+
	       |  Kitchen  |  |  Bath  |
	   y=6 |           D  D=D======+
	   y=5 +=======D===+  |        |
	       |  Living   D  D Bedroom|
	       |           |  |        |
	   y=0 +===========+DD+========+
	      x=0         x=6 x=8     x=12

	  Textures and furniture models: Poly Haven (CC0), cgbookcase (CC0) and
	  Gazebo models; see the license files in the mvsim-models repository.
	-->

	<!-- General simulation options -->
	<simul_timestep>0</simul_timestep>
	<joystick_enabled>true</joystick_enabled>
	<save_to_rawlog>$env{MVSIM_SAVE_RAWLOG_FILENAME|}</save_to_rawlog>

	<!-- GUI options -->
	<gui>
		<ortho>false</ortho>
		<show_forces>false</show_forces>  <force_scale>0.01</force_scale>
		<cam_distance>17</cam_distance>
		<cam_azimuth>-105</cam_azimuth>
		<cam_elevation>50</cam_elevation>
		<cam_point_to>5 3 0</cam_point_to>
		<fov_deg>60</fov_deg>
		<refresh_fps>40</refresh_fps>
		<show_sensor_previews>false</show_sensor_previews>
	</gui>

	<!-- Light parameters -->
	<lights>
		<enable_shadows>true</enable_shadows>
		<!-- Sun: the ceiling blocks it, so it only enters through windows -->
		<light_azimuth_deg>-60.0</light_azimuth_deg>
		<light_elevation_deg>40.0</light_elevation_deg>
		<light_ambient>0.45</light_ambient>
		<ambient_ground_color>#a8a090</ambient_ground_color>

		<!-- Ceiling lamps (warm white). These do not cast shadows, so their
		     reach is kept to about one room. -->
		<point_light> <!-- Living room -->
			<position>3.0 2.5 2.45</position> <color>#ffe2b8</color>
			<diffuse>0.9</diffuse> <specular>0.3</specular>
			<attenuation_constant>1.0</attenuation_constant>
			<attenuation_linear>0.15</attenuation_linear>
			<attenuation_quadratic>0.12</attenuation_quadratic>
		</point_light>
		<point_light> <!-- Kitchen -->
			<position>4.2 7.6 2.45</position> <color>#fff1dc</color>
			<diffuse>0.9</diffuse> <specular>0.4</specular>
			<attenuation_constant>1.0</attenuation_constant>
			<attenuation_linear>0.15</attenuation_linear>
			<attenuation_quadratic>0.15</attenuation_quadratic>
		</point_light>
		<point_light> <!-- Hallway -->
			<position>7.0 4.5 2.45</position> <color>#ffe2b8</color>
			<diffuse>0.7</diffuse> <specular>0.2</specular>
			<attenuation_constant>1.0</attenuation_constant>
			<attenuation_linear>0.2</attenuation_linear>
			<attenuation_quadratic>0.25</attenuation_quadratic>
		</point_light>
		<point_light> <!-- Bedroom -->
			<position>10.0 3.0 2.45</position> <color>#ffd9a8</color>
			<diffuse>0.8</diffuse> <specular>0.2</specular>
			<attenuation_constant>1.0</attenuation_constant>
			<attenuation_linear>0.15</attenuation_linear>
			<attenuation_quadratic>0.15</attenuation_quadratic>
		</point_light>
		<point_light> <!-- Bathroom -->
			<position>10.0 7.5 2.45</position> <color>#f4f8ff</color>
			<diffuse>0.9</diffuse> <specular>0.5</specular>
			<attenuation_constant>1.0</attenuation_constant>
			<attenuation_linear>0.2</attenuation_linear>
			<attenuation_quadratic>0.25</attenuation_quadratic>
		</point_light>
		<spot_light> <!-- Pendant lamp over the dining table -->
			<position>2.4 6.3 2.0</position> <direction>0 0 -1</direction>
			<color>#ffd29a</color> <diffuse>1.0</diffuse> <specular>0.4</specular>
			<inner_cutoff_deg>30</inner_cutoff_deg> <outer_cutoff_deg>50</outer_cutoff_deg>
			<attenuation_constant>1.0</attenuation_constant>
			<attenuation_linear>0.1</attenuation_linear>
			<attenuation_quadratic>0.1</attenuation_quadratic>
		</spot_light>
	</lights>

	<variable name="PH" value="https://mrpt.github.io/mvsim-models/textures-polyhaven"></variable>
	<variable name="CGB" value="https://mrpt.github.io/mvsim-models/textures-cgbookcase"></variable>
	<variable name="MODELS" value="https://mrpt.github.io/mvsim-models"></variable>
	<variable name="KENNEY" value="https://mrpt.github.io/mvsim-models/kenney_furniture_kit.zip/kenney_furniture_kit"></variable>
	<variable name="WALL_H" value="2.6"></variable>
	<variable name="EXT_WALL_T" value="0.25"></variable>
	<variable name="INT_WALL_T" value="0.12"></variable>

	<!-- Sky -->
	<element class="skybox">
		<textures>${MODELS}/skyboxes/TropicalSunnyDay.zip/TropicalSunnyDay/TropicalSunnyDay%s.jpg</textures>
	</element>

	<!-- ========================
	       Ground and floors
	     ======================== -->
	<!-- Garden around the house -->
	<element class="horizontal_plane">
		<x_min>-60</x_min> <y_min>-60</y_min>
		<x_max>72</x_max> <y_max>69</y_max>
		<z>-0.005</z>
		<texture>${CGB}/Grass01_1K_BaseColor.png</texture>
		<normal_map>${CGB}/Grass01_1K_NormalGL.png</normal_map>
		<texture_size_x>3.0</texture_size_x>
		<texture_size_y>3.0</texture_size_y>
	</element>

	<!-- Living room -->
	<element class="horizontal_plane">
		<x_min>0</x_min> <y_min>0</y_min>
		<x_max>6</x_max> <y_max>5</y_max>
		<texture>${PH}/herringbone_parquet_diff_1k.jpg</texture>
		<normal_map>${PH}/herringbone_parquet_nor_gl_1k.png</normal_map>
		<texture_size_x>3.4</texture_size_x>
		<texture_size_y>3.4</texture_size_y>
	</element>

	<!-- Kitchen and dining area -->
	<element class="horizontal_plane">
		<x_min>0</x_min> <y_min>5</y_min>
		<x_max>6</x_max> <y_max>9</y_max>
		<texture>${PH}/large_grey_tiles_diff_1k.jpg</texture>
		<normal_map>${PH}/large_grey_tiles_nor_gl_1k.png</normal_map>
		<texture_size_x>3.0</texture_size_x>
		<texture_size_y>3.0</texture_size_y>
	</element>

	<!-- Hallway -->
	<element class="horizontal_plane">
		<x_min>6</x_min> <y_min>0</y_min>
		<x_max>8</x_max> <y_max>9</y_max>
		<texture>${PH}/rectangular_parquet_diff_1k.jpg</texture>
		<normal_map>${PH}/rectangular_parquet_nor_gl_1k.png</normal_map>
		<texture_size_x>2.25</texture_size_x>
		<texture_size_y>2.25</texture_size_y>
	</element>

	<!-- Bedroom -->
	<element class="horizontal_plane">
		<x_min>8</x_min> <y_min>0</y_min>
		<x_max>12</x_max> <y_max>6</y_max>
		<texture>${PH}/laminate_floor_02_diff_1k.jpg</texture>
		<normal_map>${PH}/laminate_floor_02_nor_gl_1k.png</normal_map>
		<texture_size_x>1.7</texture_size_x>
		<texture_size_y>1.7</texture_size_y>
	</element>

	<!-- Bathroom -->
	<element class="horizontal_plane">
		<x_min>8</x_min> <y_min>6</y_min>
		<x_max>12</x_max> <y_max>9</y_max>
		<texture>${PH}/marble_tiles_diff_1k.jpg</texture>
		<normal_map>${PH}/marble_tiles_nor_gl_1k.png</normal_map>
		<texture_size_x>2.0</texture_size_x>
		<texture_size_y>2.0</texture_size_y>
	</element>

	<!-- Ceiling: culled from above, so the GUI camera sees into the rooms,
	     while it still blocks the sun and is seen by cameras inside the house -->
	<element class="horizontal_plane">
		<x_min>0</x_min> <y_min>0</y_min>
		<x_max>12</x_max> <y_max>9</y_max>
		<z>${WALL_H}</z>
		<cull_face>FRONT</cull_face>
		<texture>${PH}/white_plaster_02_diff_1k.jpg</texture>
		<normal_map>${PH}/white_plaster_02_nor_gl_1k.png</normal_map>
		<texture_size_x>1.0</texture_size_x>
		<texture_size_y>1.0</texture_size_y>
	</element>

	<!-- ========================
	       Exterior walls
	     ======================== -->
	<!-- South facade, with the front door into the hallway -->
	<element class="vertical_plane">
		<x0>0</x0> <y0>0</y0> <x1>12</x1> <y1>0</y1>
		<height>${WALL_H}</height> <thickness>${EXT_WALL_T}</thickness>
		<texture>${PH}/painted_plaster_wall_diff_1k.jpg</texture>
		<normal_map>${PH}/painted_plaster_wall_nor_gl_1k.png</normal_map>
		<texture_size_x>2.0</texture_size_x> <texture_size_y>2.0</texture_size_y>
		<window> <position>0.25</position> <width>1.6</width> <z_min>0.9</z_min> <z_max>2.2</z_max> </window>
		<door> <position>0.5833</position> <width>1.0</width> <z_min>0.0</z_min> <z_max>2.1</z_max> <name>front_door</name> </door>
		<window> <position>0.8333</position> <width>1.4</width> <z_min>0.9</z_min> <z_max>2.2</z_max> </window>
	</element>

	<!-- East facade -->
	<element class="vertical_plane">
		<x0>12</x0> <y0>0</y0> <x1>12</x1> <y1>9</y1>
		<height>${WALL_H}</height> <thickness>${EXT_WALL_T}</thickness>
		<texture>${PH}/painted_plaster_wall_diff_1k.jpg</texture>
		<normal_map>${PH}/painted_plaster_wall_nor_gl_1k.png</normal_map>
		<texture_size_x>2.0</texture_size_x> <texture_size_y>2.0</texture_size_y>
		<window> <position>0.3333</position> <width>1.4</width> <z_min>0.9</z_min> <z_max>2.2</z_max> </window>
		<window> <position>0.8333</position> <width>0.8</width> <z_min>1.4</z_min> <z_max>2.1</z_max> </window>
	</element>

	<!-- North facade -->
	<element class="vertical_plane">
		<x0>12</x0> <y0>9</y0> <x1>0</x1> <y1>9</y1>
		<height>${WALL_H}</height> <thickness>${EXT_WALL_T}</thickness>
		<texture>${PH}/painted_plaster_wall_diff_1k.jpg</texture>
		<normal_map>${PH}/painted_plaster_wall_nor_gl_1k.png</normal_map>
		<texture_size_x>2.0</texture_size_x> <texture_size_y>2.0</texture_size_y>
		<window> <position>0.75</position> <width>1.6</width> <z_min>1.1</z_min> <z_max>2.2</z_max> </window>
	</element>

	<!-- West facade -->
	<element class="vertical_plane">
		<x0>0</x0> <y0>9</y0> <x1>0</x1> <y1>0</y1>
		<height>${WALL_H}</height> <thickness>${EXT_WALL_T}</thickness>
		<texture>${PH}/painted_plaster_wall_diff_1k.jpg</texture>
		<normal_map>${PH}/painted_plaster_wall_nor_gl_1k.png</normal_map>
		<texture_size_x>2.0</texture_size_x> <texture_size_y>2.0</texture_size_y>
		<window> <position>0.2222</position> <width>1.4</width> <z_min>0.9</z_min> <z_max>2.2</z_max> </window>
		<window> <position>0.7222</position> <width>2.0</width> <z_min>0.6</z_min> <z_max>2.2</z_max> </window>
	</element>

	<!-- ========================
	       Interior walls
	     ======================== -->
	<!-- Living room / kitchen -->
	<element class="vertical_plane">
		<x0>0</x0> <y0>5</y0> <x1>6</x1> <y1>5</y1>
		<height>${WALL_H}</height> <thickness>${INT_WALL_T}</thickness>
		<texture>${PH}/white_plaster_02_diff_1k.jpg</texture>
		<normal_map>${PH}/white_plaster_02_nor_gl_1k.png</normal_map>
		<texture_size_x>1.0</texture_size_x> <texture_size_y>1.0</texture_size_y>
		<door> <position>0.75</position> <width>1.2</width> <z_min>0.0</z_min> <z_max>2.1</z_max> </door>
	</element>

	<!-- Living room / hallway -->
	<element class="vertical_plane">
		<x0>6</x0> <y0>0</y0> <x1>6</x1> <y1>5</y1>
		<height>${WALL_H}</height> <thickness>${INT_WALL_T}</thickness>
		<texture>${PH}/white_plaster_02_diff_1k.jpg</texture>
		<normal_map>${PH}/white_plaster_02_nor_gl_1k.png</normal_map>
		<texture_size_x>1.0</texture_size_x> <texture_size_y>1.0</texture_size_y>
		<door> <position>0.7</position> <width>1.0</width> <z_min>0.0</z_min> <z_max>2.1</z_max> </door>
	</element>

	<!-- Kitchen / hallway -->
	<element class="vertical_plane">
		<x0>6</x0> <y0>5</y0> <x1>6</x1> <y1>9</y1>
		<height>${WALL_H}</height> <thickness>${INT_WALL_T}</thickness>
		<texture>${PH}/white_plaster_02_diff_1k.jpg</texture>
		<normal_map>${PH}/white_plaster_02_nor_gl_1k.png</normal_map>
		<texture_size_x>1.0</texture_size_x> <texture_size_y>1.0</texture_size_y>
		<door> <position>0.375</position> <width>1.0</width> <z_min>0.0</z_min> <z_max>2.1</z_max> </door>
	</element>

	<!-- Hallway / bedroom -->
	<element class="vertical_plane">
		<x0>8</x0> <y0>0</y0> <x1>8</x1> <y1>6</y1>
		<height>${WALL_H}</height> <thickness>${INT_WALL_T}</thickness>
		<texture>${PH}/beige_wall_001_diff_1k.jpg</texture>
		<normal_map>${PH}/beige_wall_001_nor_gl_1k.png</normal_map>
		<texture_size_x>3.0</texture_size_x> <texture_size_y>3.0</texture_size_y>
		<door> <position>0.75</position> <width>0.9</width> <z_min>0.0</z_min> <z_max>2.1</z_max> </door>
	</element>

	<!-- Hallway / bathroom -->
	<element class="vertical_plane">
		<x0>8</x0> <y0>6</y0> <x1>8</x1> <y1>9</y1>
		<height>${WALL_H}</height> <thickness>${INT_WALL_T}</thickness>
		<texture>${PH}/white_plaster_02_diff_1k.jpg</texture>
		<normal_map>${PH}/white_plaster_02_nor_gl_1k.png</normal_map>
		<texture_size_x>1.0</texture_size_x> <texture_size_y>1.0</texture_size_y>
		<door> <position>0.3333</position> <width>0.8</width> <z_min>0.0</z_min> <z_max>2.1</z_max> </door>
	</element>

	<!-- Bedroom / bathroom -->
	<element class="vertical_plane">
		<x0>8</x0> <y0>6</y0> <x1>12</x1> <y1>6</y1>
		<height>${WALL_H}</height> <thickness>${INT_WALL_T}</thickness>
		<texture>${PH}/beige_wall_001_diff_1k.jpg</texture>
		<normal_map>${PH}/beige_wall_001_nor_gl_1k.png</normal_map>
		<texture_size_x>3.0</texture_size_x> <texture_size_y>3.0</texture_size_y>
		<door> <position>0.1375</position> <width>0.7</width> <z_min>0.0</z_min> <z_max>2.1</z_max> </door>
	</element>

	<!-- Bathroom wall tiles (2 m high), just inside the bathroom walls -->
	<element class="vertical_plane">
		<x0>8.07</x0> <y0>6.07</y0> <x1>8.07</x1> <y1>8.87</y1>
		<height>2.0</height> <thickness>0.01</thickness>
		<texture>${PH}/long_white_tiles_diff_1k.jpg</texture>
		<normal_map>${PH}/long_white_tiles_nor_gl_1k.png</normal_map>
		<texture_size_x>1.27</texture_size_x> <texture_size_y>1.27</texture_size_y>
		<door> <position>0.3321</position> <width>0.8</width> <z_min>0.0</z_min> <z_max>2.0</z_max> </door>
	</element>
	<element class="vertical_plane">
		<x0>8.07</x0> <y0>8.87</y0> <x1>11.87</x1> <y1>8.87</y1>
		<height>2.0</height> <thickness>0.01</thickness>
		<texture>${PH}/long_white_tiles_diff_1k.jpg</texture>
		<normal_map>${PH}/long_white_tiles_nor_gl_1k.png</normal_map>
		<texture_size_x>1.27</texture_size_x> <texture_size_y>1.27</texture_size_y>
	</element>
	<element class="vertical_plane">
		<x0>11.87</x0> <y0>8.87</y0> <x1>11.87</x1> <y1>6.07</y1>
		<height>2.0</height> <thickness>0.01</thickness>
		<texture>${PH}/long_white_tiles_diff_1k.jpg</texture>
		<normal_map>${PH}/long_white_tiles_nor_gl_1k.png</normal_map>
		<texture_size_x>1.27</texture_size_x> <texture_size_y>1.27</texture_size_y>
		<window> <position>0.4964</position> <width>0.8</width> <z_min>1.4</z_min> <z_max>2.0</z_max> </window>
	</element>
	<element class="vertical_plane">
		<x0>11.87</x0> <y0>6.07</y0> <x1>8.07</x1> <y1>6.07</y1>
		<height>2.0</height> <thickness>0.01</thickness>
		<texture>${PH}/long_white_tiles_diff_1k.jpg</texture>
		<normal_map>${PH}/long_white_tiles_nor_gl_1k.png</normal_map>
		<texture_size_x>1.27</texture_size_x> <texture_size_y>1.27</texture_size_y>
		<door> <position>0.8737</position> <width>0.7</width> <z_min>0.0</z_min> <z_max>2.0</z_max> </door>
	</element>

	<!-- Living room rug -->
	<element class="horizontal_plane">
		<x_min>1.5</x_min> <y_min>1.25</y_min>
		<x_max>3.7</x_max> <y_max>2.75</y_max>
		<z>0.006</z>
		<texture>${PH}/fabric_pattern_07_col_1_1k.jpg</texture>
		<normal_map>${PH}/fabric_pattern_07_nor_gl_1k.png</normal_map>
		<texture_size_x>0.55</texture_size_x>
		<texture_size_y>0.55</texture_size_y>
	</element>

	<!-- ========================
	       Garden
	     ======================== -->
	<!-- Path to the front door -->
	<element class="horizontal_plane">
		<x_min>6.4</x_min> <y_min>-6.0</y_min>
		<x_max>7.6</x_max> <y_max>-0.12</y_max>
		<z>0.003</z>
		<texture>${PH}/concrete_pavers_02_diff_1k.jpg</texture>
		<normal_map>${PH}/concrete_pavers_02_nor_gl_1k.png</normal_map>
		<texture_size_x>2.0</texture_size_x>
		<texture_size_y>2.0</texture_size_y>
	</element>
	<!-- Terrace -->
	<element class="horizontal_plane">
		<x_min>0.4</x_min> <y_min>-3.2</y_min>
		<x_max>5.6</x_max> <y_max>-0.12</y_max>
		<z>0.003</z>
		<texture>${PH}/concrete_pavers_02_diff_1k.jpg</texture>
		<normal_map>${PH}/concrete_pavers_02_nor_gl_1k.png</normal_map>
		<texture_size_x>2.0</texture_size_x>
		<texture_size_y>2.0</texture_size_y>
	</element>

	<!-- ========================
	       Furniture classes
	     ======================== -->
	<!-- Poly Haven models (glTF, Y-up) -->
	<block:class name="sofa">
		<static>true</static> <shape_from_visual/>
		<visual> <model_uri>${MODELS}/sofa_02.zip/sofa_02/sofa_02.gltf</model_uri> <model_roll>90.0</model_roll> </visual>
	</block:class>
	<block:class name="coffee_table">
		<static>true</static> <shape_from_visual/>
		<visual> <model_uri>${MODELS}/modern_coffee_table_01.zip/modern_coffee_table_01/modern_coffee_table_01.gltf</model_uri> <model_roll>90.0</model_roll> </visual>
	</block:class>
	<block:class name="armchair">
		<static>true</static> <shape_from_visual/>
		<visual> <model_uri>${MODELS}/modern_arm_chair_01.zip/modern_arm_chair_01/modern_arm_chair_01.gltf</model_uri> <model_roll>90.0</model_roll> </visual>
	</block:class>
	<block:class name="bookshelf">
		<static>true</static> <shape_from_visual/>
		<visual> <model_uri>${MODELS}/wooden_bookshelf_worn.zip/wooden_bookshelf_worn/wooden_bookshelf_worn.gltf</model_uri> <model_roll>90.0</model_roll> </visual>
	</block:class>
	<block:class name="potted_plant">
		<static>true</static> <shape_from_visual/>
		<visual> <model_uri>${MODELS}/potted_plant_02.zip/potted_plant_02/potted_plant_02.gltf</model_uri> <model_roll>90.0</model_roll> </visual>
	</block:class>
	<block:class name="side_table">
		<static>true</static> <shape_from_visual/>
		<visual> <model_uri>${MODELS}/side_table_01.zip/side_table_01/side_table_01.gltf</model_uri> <model_roll>90.0</model_roll> </visual>
	</block:class>
