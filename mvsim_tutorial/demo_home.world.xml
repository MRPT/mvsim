	<!-- ========================
	       Robot
	     ======================== -->
	<!-- A Jackal robot (0.51 x 0.43 m, fits through all doors) with a 3D lidar,
	     an RGB-D camera and an IMU -->
	<include file="../definitions/jackal.vehicle.xml"
		default_sensors="false"
	/>
	<vehicle name="r1" class="jackal">
		<init_pose>4.0 3.4 180</init_pose>  <!-- In global coords: x,y, yaw(deg) -->
		<init_vel>0 0 0</init_vel>  <!-- In local coords: vx,vy, omega(deg/s) -->

		<!-- Sensor tower: the RGB-D camera on the deck, and the 3D lidar on top of
		     it, so the camera does not occlude the lidar -->
		<include file="../definitions/velodyne-vlp16.sensor.xml"
			sensor_x="0.10" sensor_z="0.40"
			sensor_name="lidar1"
			sensor_std_noise="0.005"
			max_range="30.0"
		/>
		<include file="../definitions/rgbd_camera.sensor.xml"
			sensor_x="0.10" sensor_z="0.30"
			sensor_name="camera1"
			sensor_period_sec="0.10"
			show_3d_pointcloud="false"
		/>
		<include file="../definitions/imu.sensor.xml"
			sensor_x="0.0" sensor_z="0.20"
			sensor_period_sec="$f{1/100.0}"
		/>
	</vehicle>
