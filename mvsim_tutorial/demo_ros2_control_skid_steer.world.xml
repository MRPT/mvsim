<mvsim_world version="1.0">
	<!--
	  A 4-wheel skid-steer robot whose vehicle definition is generated from its
	  URDF (with mvsim-urdf2xml), driven by ros2_control controllers
	  (diff_drive_controller). Its URDF has base_footprint on the ground and
	  base_link above it: the MVSim vehicle frame is base_footprint.
	  Launch with:
	    ros2 launch mvsim demo_ros2_control.launch.py vehicle:=skid_steer_4wd
	-->
	<simul_timestep>0.005</simul_timestep>

	<gui>
		<ortho>false</ortho>
		<show_forces>true</show_forces>  <force_scale>0.01</force_scale>
		<cam_distance>10</cam_distance>
		<fov_deg>60</fov_deg>
		<follow_vehicle>r1</follow_vehicle>
	</gui>

	<element class="occupancy_grid">
		<file>demo_world1.png</file>
		<resolution>0.1</resolution>
		<centerpixel_x>100</centerpixel_x>
		<centerpixel_y>100</centerpixel_y>
	</element>

	<include file="urdf2xml/skid_steer_4wd.vehicle.xml"
		controller="ros2_control"
		controllers_yaml="ros2_control/skid_steer_4wd_controllers.yaml"
		robot_description="$env{MVSIM_ROBOT_DESCRIPTION|generated}"
	/>

	<vehicle name="r1" class="skid_steer_4wd">
		<init_pose>0 0 0</init_pose>
	</vehicle>
</mvsim_world>
