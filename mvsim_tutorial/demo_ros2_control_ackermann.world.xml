<mvsim_world version="1.0">
	<!--
	  A car-like vehicle (class "ackermann": one motor per wheel) driven by the
	  ros2_control ackermann_steering_controller: two rear traction joints
	  (velocity) and the two front wheel steering joints (position), instead of
	  MVSim built-in controllers. Launch with:
	    ros2 launch mvsim demo_ros2_control.launch.py vehicle:=car_ackermann
	-->
	<simul_timestep>0.005</simul_timestep>

	<gui>
		<ortho>false</ortho>
		<show_forces>true</show_forces>  <force_scale>0.005</force_scale>
		<cam_distance>15</cam_distance>
		<fov_deg>60</fov_deg>
		<follow_vehicle>car</follow_vehicle>
	</gui>

	<element class="horizontal_plane">
		<x_min>-30</x_min> <y_min>-30</y_min> <x_max>30</x_max> <y_max>30</y_max> <z>0.0</z>
		<color>#909090</color>
	</element>
	<element class="ground_grid">
		<floating>true</floating>
	</element>

	<!-- Some obstacles around, for the LiDAR (out of the way of turns of up to 8 m radius) -->
	<block:class name="box">
		<mass>500</mass>
		<color>#0080ff</color>
		<zmax>1.5</zmax>
		<ground_friction>1.0</ground_friction>
		<shape> <pt>-1 -1</pt> <pt>-1 1</pt> <pt>1 1</pt> <pt>1 -1</pt> </shape>
	</block:class>
	<for var="i" from="0" to="7">
		<block class="box">
			<init_pose>$f{20*cos(i*pi/4)} $f{20*sin(i*pi/4)} $f{i*45}</init_pose>
		</block>
	</for>

	<include file="../definitions/ackermann.vehicle.xml"
		controller="ros2_control"
		steering_joints="per_wheel"
		controllers_yaml="ros2_control/car_ackermann_controllers.yaml"
		robot_description="$env{MVSIM_ROBOT_DESCRIPTION|generated}"
	/>

	<vehicle name="car" class="car_ackermann">
		<init_pose>0 0 0</init_pose>
		<include file="../definitions/lidar2d.sensor.xml"
		  sensor_x="1.8" sensor_z="1.1" sensor_yaw="0" sensor_name="laser1"
		  fov_degrees="270" sensor_nrays="271"
		/>
	</vehicle>
</mvsim_world>
