<mvsim_world version="1.0">
	<!--
	  A warehouse (35 x 26 m) with a storage hall with racks and a pallet staging
	  area, a loading dock with two dock doors (a truck at one of them), a robot
	  charging and maintenance bay, and an office. The bay and the office open to
	  the hall and to each other, so there is a loop.

	  Floor plan (x to the right, y up, meters):

	   y=13 +==========================+=======+
	        D  staging area            D office|
	   y=8  |                          +===D===+
	        |==walkway=================D  bay  |
	   y=3  |  racks                   +=======+
	        |  racks          cross    |  dock D (truck)
	        |  racks          aisle    |       D
	   y=-13+==========================+=======+
	      x=-15                       x=12    x=20

	  Textures and models: Poly Haven (CC0), cgbookcase (CC0) and existing
	  mvsim-models assets; see the license files in the mvsim-models repository.
	-->

	<!-- General simulation options -->
	<simul_timestep>0</simul_timestep> <!-- Simulation fixed-time interval for numerical integration [seconds] or 0 to autodetermine -->

	<joystick_enabled>true</joystick_enabled>
	<save_to_rawlog>$env{MVSIM_SAVE_RAWLOG_FILENAME|}</save_to_rawlog>

	<!-- Optional: save all sensor data into an MRPT .rawlog dataset file: -->
	<!-- <save_to_rawlog>warehouse_dataset.rawlog</save_to_rawlog> -->
	<!-- If save_to_rawlog is enabled, this defines the rate in Hz to generate odometry observations -->
	<!-- <rawlog_odometry_rate>20.0</rawlog_odometry_rate> -->
	<!-- <save_ground_truth_trajectory>warehouse_dataset_gt.txt</save_ground_truth_trajectory> -->

	<!-- GUI options -->
	<gui>
		<ortho>false</ortho>
		<show_forces>false</show_forces>  <force_scale>0.01</force_scale>
		<cam_distance>34</cam_distance>
		<cam_azimuth>-115</cam_azimuth>
		<cam_elevation>55</cam_elevation>
		<cam_point_to>3 0 0</cam_point_to>
		<fov_deg>60</fov_deg>
		<refresh_fps>40</refresh_fps>
		<!-- <follow_vehicle>r1</follow_vehicle> -->
	</gui>

	<!-- Light parameters -->
	<lights>
		<enable_shadows>true</enable_shadows>
		<!-- Sun: the roof blocks it, so it only enters through windows and the open dock door -->
		<light_azimuth_deg>-75.0</light_azimuth_deg>
		<light_elevation_deg>35.0</light_elevation_deg>
		<light_ambient>0.60</light_ambient>
		<ambient_ground_color>#9a958c</ambient_ground_color>

		<point_light> <!-- High bay lamp, south aisle -->
			<position>-4.5 -8.0 6.2</position> <color>#fff4e0</color>
			<diffuse>1.2</diffuse> <specular>0.3</specular>
			<attenuation_constant>1.0</attenuation_constant>
			<attenuation_linear>0.02</attenuation_linear>
			<attenuation_quadratic>0.006</attenuation_quadratic>
		</point_light>
		<point_light> <!-- High bay lamp, middle aisle -->
			<position>-4.5 -0.6 6.2</position> <color>#fff4e0</color>
			<diffuse>1.2</diffuse> <specular>0.3</specular>
			<attenuation_constant>1.0</attenuation_constant>
			<attenuation_linear>0.02</attenuation_linear>
			<attenuation_quadratic>0.006</attenuation_quadratic>
		</point_light>
		<point_light> <!-- High bay lamp, staging area west -->
			<position>-9.0 9.5 6.2</position> <color>#fff4e0</color>
			<diffuse>1.2</diffuse> <specular>0.3</specular>
			<attenuation_constant>1.0</attenuation_constant>
			<attenuation_linear>0.02</attenuation_linear>
			<attenuation_quadratic>0.006</attenuation_quadratic>
		</point_light>
		<point_light> <!-- High bay lamp, staging area east -->
			<position>3.0 9.5 6.2</position> <color>#fff4e0</color>
			<diffuse>1.2</diffuse> <specular>0.3</specular>
			<attenuation_constant>1.0</attenuation_constant>
			<attenuation_linear>0.02</attenuation_linear>
			<attenuation_quadratic>0.006</attenuation_quadratic>
		</point_light>
		<point_light> <!-- High bay lamp, loading dock -->
			<position>14.0 -5.0 6.2</position> <color>#fff4e0</color>
			<diffuse>1.2</diffuse> <specular>0.3</specular>
			<attenuation_constant>1.0</attenuation_constant>
			<attenuation_linear>0.02</attenuation_linear>
			<attenuation_quadratic>0.006</attenuation_quadratic>
		</point_light>
		<point_light> <!-- Office ceiling lamp -->
			<position>16.0 10.5 2.85</position> <color>#fff8f0</color>
			<diffuse>0.9</diffuse> <specular>0.3</specular>
			<attenuation_constant>1.0</attenuation_constant>
			<attenuation_linear>0.15</attenuation_linear>
			<attenuation_quadratic>0.1</attenuation_quadratic>
		</point_light>
		<point_light> <!-- Charging bay ceiling lamp -->
			<position>16.0 5.5 2.85</position> <color>#f0f6ff</color>
			<diffuse>0.9</diffuse> <specular>0.3</specular>
			<attenuation_constant>1.0</attenuation_constant>
			<attenuation_linear>0.15</attenuation_linear>
			<attenuation_quadratic>0.1</attenuation_quadratic>
		</point_light>
	</lights>

	<variable name="PH" value="https://mrpt.github.io/mvsim-models/textures-polyhaven"></variable>
	<variable name="CGB" value="https://mrpt.github.io/mvsim-models/textures-cgbookcase"></variable>
	<variable name="MODELS" value="https://mrpt.github.io/mvsim-models"></variable>
	<variable name="CEILING_HEIGHT" value="7.5"></variable>
	<variable name="ROOM_H" value="3.0"></variable>
	<variable name="WALL_T" value="0.25"></variable>
	<variable name="PARTITION_T" value="0.12"></variable>

	<!-- Sky -->
	<element class="skybox">
		<textures>${MODELS}/skyboxes/TropicalSunnyDay.zip/TropicalSunnyDay/TropicalSunnyDay%s.jpg</textures>
	</element>

