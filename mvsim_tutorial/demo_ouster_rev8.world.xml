<mvsim_world version="1.0">
	<!--
	  Outdoor scenario for the Ouster Rev8 RGB LiDAR (definitions/ouster-rev8.sensor.xml)
	  on a Jackal robot: a village with houses, a paved square, parked cars and
	  people walking around, surrounded by hills with trees, a ring road and a
	  road up to a hilltop.

	  The robot is teleoperated by default. To drive it unattended along a fixed
	  loop (exactly reproducible, see definitions/trajectories/village_loop.trajectory.xml), set the
	  environment variable:
	      MVSIM_DEMO_TRAJECTORY=1

	  The terrain images are generated by generate_demo_ouster_rev8_terrain.py.
	-->

	<!-- Georeferenced coordinates, for the GNSS sensor -->
	<georeference>
		<latitude>36.8385</latitude>
		<longitude>-2.4597</longitude>
		<height>50.0</height>
		<world_to_enu_rotation_deg>0.0</world_to_enu_rotation_deg>
	</georeference>

	<!-- General simulation options -->
	<simul_timestep>0</simul_timestep> <!-- 0: auto-determine -->

	<!-- Optional: save all sensor data into an MRPT .rawlog dataset file: -->
	<!-- <save_to_rawlog>ouster_rev8_dataset.rawlog</save_to_rawlog> -->
	<!-- <rawlog_odometry_rate>20.0</rawlog_odometry_rate> -->
	<!-- <save_ground_truth_trajectory>gt.txt</save_ground_truth_trajectory> -->

	<gui>
		<ortho>false</ortho>
		<show_forces>false</show_forces>
		<cam_distance>18</cam_distance>
		<cam_azimuth>200</cam_azimuth>
		<cam_elevation>25</cam_elevation>
		<fov_deg>60</fov_deg>
		<refresh_fps>20</refresh_fps>
		<follow_vehicle>r1</follow_vehicle>
		<show_trajectories>true</show_trajectories>
	</gui>

	<lights>
		<enable_shadows>true</enable_shadows>
		<light_azimuth_deg>-35.0</light_azimuth_deg>
		<light_elevation_deg>45.0</light_elevation_deg>
		<light_ambient>0.35</light_ambient>
		<shadow_map_size>4096</shadow_map_size>
	</lights>

	<variable name="MODELS" value="https://mrpt.github.io/mvsim-models"></variable>
	<variable name="USE_TRAJECTORY" value="$env{MVSIM_DEMO_TRAJECTORY|0}"></variable>

	<element class="skybox">
		<textures>${MODELS}/skyboxes/TropicalSunnyDay.zip/TropicalSunnyDay/TropicalSunnyDay%s.jpg</textures>
	</element>

	<!-- ========================
	       Terrain: 160x160 m
	     ======================== -->
	<element class="elevation_map">
		<elevation_image>demo_ouster_rev8_elevation.png</elevation_image>
		<elevation_image_min_z>0.0</elevation_image_min_z>
		<elevation_image_max_z>10.0</elevation_image_max_z>
		<resolution>1.0</resolution>
		<texture_image>demo_ouster_rev8_texture.jpg</texture_image>
		<texture_extension_x>160</texture_extension_x>
		<texture_extension_y>160</texture_extension_y>
		<corner_min_x>-80</corner_min_x>
		<corner_min_y>-80</corner_min_y>
	</element>

	<!-- ========================
	       Object classes
	     ======================== -->
	<block:class name="house_1">
		<static>true</static> <shape_from_visual/>
