	<!-- ========================
	       Robot
	     ======================== -->
	<if condition="$f{USE_TRAJECTORY == 0}">
		<include file="../definitions/jackal.vehicle.xml" default_sensors="false" />
	</if>
	<if condition="$f{USE_TRAJECTORY != 0}">
		<include file="../definitions/jackal.vehicle.xml" default_sensors="false"
			controller="trajectory" use_trajectory_file="true"
			trajectory_file="trajectories/village_loop.trajectory.xml"
		/>
	</if>

	<vehicle name="r1" class="jackal">
		<!-- On the main street, heading east (the trajectory start, if enabled) -->
		<init_pose>-30 -1.75 0</init_pose>

		<!-- Ouster Rev8 OS1-128, RGB, on a short mast -->
		<include file="../definitions/ouster-rev8.sensor.xml"
			sensor_name="lidar1"
			sensor_x="0.0" sensor_z="0.55"
		/>
		<!-- IMU at the lidar position (as the Ouster internal IMU) -->
		<include file="../definitions/imu.sensor.xml"
