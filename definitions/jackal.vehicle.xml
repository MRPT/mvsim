<!--
  Vehicle class definition file.
  Intended to be included into world XML files.
  Common sensors could be included here, but they are left to be included in 
  class instantiations.
  Refer to mvsim_tutorial example files.
-->
<vehicle:class name="jackal">

    <!--  Dynamical model -->
    <dynamics class="differential_4_wheels">
        <!-- Params -->
        <lf_wheel pos="0.13  0.16" mass="1.0" width="0.03" diameter="0.20">
          <visual> <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../models/jackal_description/jackal-wheel.dae</model_uri> </visual>
        </lf_wheel>
        <rf_wheel pos="0.13 -0.16" mass="1.0" width="0.03" diameter="0.20">
          <visual> <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../models/jackal_description/jackal-wheel.dae</model_uri> </visual>
        </rf_wheel>
        <lr_wheel pos="-0.13  0.16" mass="1.0" width="0.03" diameter="0.20">
          <visual> <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../models/jackal_description/jackal-wheel.dae</model_uri> </visual>
        </lr_wheel>
        <rr_wheel pos="-0.13 -0.16" mass="1.0" width="0.03" diameter="0.20">
          <visual> <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../models/jackal_description/jackal-wheel.dae</model_uri> </visual>
        </rr_wheel>

        <chassis mass="10.0" zmin="0.05" zmax="0.25">
            <shape_from_visual/> <!-- automatic shape,zmin,zmax from 3D mesh-->
        </chassis>

        <!--   Motor controller -->
        <controller class="${controller|twist_ideal}">  <!-- "twist_ideal" or "twist_pid" -->
          <!-- Optimal parameters from the mvsim-pid-tuner tool -->
          <KP>18.2909</KP>
          <KI>474.4889</KI>
          <KD>0.0000</KD>
          <max_torque>100</max_torque>
          <!-- Joystick teleop maximum speeds (overridable via include variables) -->
          <joyMaxLinSpeed>${joyMaxLinSpeed|1.0}</joyMaxLinSpeed>
          <joyMaxAngSpeed>${joyMaxAngSpeed|0.5}</joyMaxAngSpeed>
        </controller>
    </dynamics>

    <!-- Friction force simulation -->
    <friction class="default">
        <mu>0.8</mu>
        <C_damping>0.05</C_damping>
        <C_rr>0.01</C_rr>  <!-- Rolling resistance coefficient -->
    </friction>

    <!-- Noisy odometry parameters. These are multipliers to actual SE(2) increments -->
    <odometry
      x_multiplier="$f{1.0+0.02*randn()}"
      y_multiplier="$f{1.0+0.01*randn()}"
      yaw_multiplier="$f{1.0+0.03*randn()}"
    />


    <!--  Custom visualization model -->
    <!-- 3D model filename to load (local or remote http://uri ) -->
    <visual>
        <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../models/jackal_description/jackal.dae</model_uri>
        <model_yaw>0.0</model_yaw>
        <model_pitch>0.0</model_pitch>
        <model_roll>90.0</model_roll>
    </visual>

    <!-- Headlights, enabled with the include variable headlights="true".
         Switched on/off with the GUI editor ("Lights" tab), or the ZMQ
         service "set_light_state". -->
    <if condition="${headlights|false}">
      <light_group name="headlights" initially_on="${headlights_on|true}">
        <spot_light>
          <position>0.26 0.11 0.17</position> <direction>1 0 -0.25</direction>
          <color>#fff4e0</color> <diffuse>2.5</diffuse> <specular>0.05</specular>
          <inner_cutoff_deg>18</inner_cutoff_deg> <outer_cutoff_deg>28</outer_cutoff_deg>
          <attenuation_linear>0.05</attenuation_linear> <attenuation_quadratic>0.02</attenuation_quadratic>
          <range>12.0</range>
        </spot_light>
        <spot_light>
          <position>0.26 -0.11 0.17</position> <direction>1 0 -0.25</direction>
          <color>#fff4e0</color> <diffuse>2.5</diffuse> <specular>0.05</specular>
          <inner_cutoff_deg>18</inner_cutoff_deg> <outer_cutoff_deg>28</outer_cutoff_deg>
          <attenuation_linear>0.05</attenuation_linear> <attenuation_quadratic>0.02</attenuation_quadratic>
          <range>12.0</range>
        </spot_light>
      </light_group>
      <!-- The lamp models: their lenses glow while the light group is on -->
      <visual light_group="headlights">
        <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../models/headlight.obj</model_uri>
        <model_offset_x>0.255</model_offset_x> <model_offset_y>0.11</model_offset_y> <model_offset_z>0.17</model_offset_z>
        <cast_shadows>false</cast_shadows>
      </visual>
      <visual light_group="headlights">
        <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../models/headlight.obj</model_uri>
        <model_offset_x>0.255</model_offset_x> <model_offset_y>-0.11</model_offset_y> <model_offset_z>0.17</model_offset_z>
        <cast_shadows>false</cast_shadows>
      </visual>
    </if>


    <if condition="${default_sensors|true}">
      <!-- Sensors -->
      <include file="lidar2d.sensor.xml"
        sensor_x="-0.15" sensor_z="0.25" sensor_yaw="180"
        sensor_period_sec="0.10"
        raytrace_3d="${lidar2d_raytrace|false}"
        fov_degrees="${lidar2d_fov_degrees|180}"
        sensor_name="scanner1"
      />

      <include file="helios-32-FOV-31.sensor.xml"
        sensor_x="0.15" sensor_z="$f{0.27 + 0.08}"
        sensor_std_noise="0.0025"
        sensor_publish="false"
        sensor_name="lidar1"
        sensor_rate="10.0"
        generate_intensity="true"
        horz_resolution_factor="1.5"
        vert_resolution_factor="1.0"
      />

      <include file="camera.sensor.xml" 
        sensor_x="0.2"  sensor_y="0" sensor_z="0.27"
        sensor_period_sec="0.10"
        sensor_name="cam1"
        />
    </if>

</vehicle:class>
