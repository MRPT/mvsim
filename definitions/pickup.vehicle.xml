<!--
  Vehicle class definition file.
  Intended to be included into world XML files.
  Common sensors could be included here, but they are left to be included in 
  class instantiations.
  Refer to mvsim_tutorial example files.
-->
<vehicle:class name="pickup">
    <!--  Dynamical model -->
    <dynamics class="ackermann">
        <!-- Wheels: positions and sizes from the 3D model. Its left wheel is the
             model of all of them (rotated 180 deg on the right side). -->
        <!-- Rear wheels -->
        <rl_wheel pos="-1.777  0.919" mass="6.0" width="0.31" diameter="0.844">
            <visual> <model_uri>https://mrpt.github.io/mvsim-models/vehicle_pickup_v2.zip/vehicle_pickup/pickup_wheel.dae</model_uri> <model_yaw>-90.0</model_yaw> <model_roll>90.0</model_roll> </visual>
        </rl_wheel>
        <rr_wheel pos="-1.777 -0.919" mass="6.0" width="0.31" diameter="0.844">
            <visual> <model_uri>https://mrpt.github.io/mvsim-models/vehicle_pickup_v2.zip/vehicle_pickup/pickup_wheel.dae</model_uri> <model_yaw>90.0</model_yaw> <model_roll>90.0</model_roll> </visual>
        </rr_wheel>

        <!-- Front wheels -->
        <fl_wheel mass="6.0" width="0.31" diameter="0.844">
            <visual> <model_uri>https://mrpt.github.io/mvsim-models/vehicle_pickup_v2.zip/vehicle_pickup/pickup_wheel.dae</model_uri> <model_yaw>-90.0</model_yaw> <model_roll>90.0</model_roll> </visual>
        </fl_wheel>
        <fr_wheel mass="6.0" width="0.31" diameter="0.844">
            <visual> <model_uri>https://mrpt.github.io/mvsim-models/vehicle_pickup_v2.zip/vehicle_pickup/pickup_wheel.dae</model_uri> <model_yaw>90.0</model_yaw> <model_roll>90.0</model_roll> </visual>
        </fr_wheel>
        <f_wheels_x>1.776</f_wheels_x>
        <f_wheels_d>1.838</f_wheels_d>
        <max_steer_ang_deg>40.0</max_steer_ang_deg>
        <max_steer_rate_deg>45</max_steer_rate_deg>  <!-- 0: instantaneous steering -->

        <chassis mass="2000.0" zmin="0.01" zmax="1.9">
            <shape_from_visual/> <!-- automatic shape,zmin,zmax from 3D mesh-->
        </chassis>

        <!--   Motor controller -->
        <controller class="twist_front_steer_pid">
            <!-- Params -->
            <KP>16200</KP>  <KI>324</KI> <KD>0</KD>
            <V>0.0</V><W>0</W>
            <max_torque>1250</max_torque>
        </controller>

        <!-- Available types: 
            open_front
            open_rear
            open_4wd
            torsen_front
            torsen_rear
            torsen_4wd -->
        <drivetrain type="torsen_4wd">
            <front_rear_split>0.5</front_rear_split>
            <front_rear_bias>1.5</front_rear_bias>

            <front_left_right_split>0.5</front_left_right_split>
            <front_left_right_bias>1.5</front_left_right_bias>

            <rear_left_right_split>0.5</rear_left_right_split>
            <rear_left_right_bias>1.5</rear_left_right_bias>
        </drivetrain>

    </dynamics>

    <!-- Chassis suspension: springs and dampers between the chassis and the wheels
         (disabled by default; set the variable suspension="true" to enable it) -->
    <suspension enabled="${suspension|false}">
        <frequency_hz>1.4</frequency_hz>  <!-- Heave natural frequency -->
        <damping_ratio>0.3</damping_ratio>
    </suspension>

    <!-- Friction force simulation -->
    <friction class="default">
        <mu>0.7</mu>
        <C_damping>0.05</C_damping>
        <C_rr>0.01</C_rr>  <!-- Rolling resistance coefficient -->
    </friction>


    <!-- Noisy odometry parameters. These are multipliers to actual SE(2) increments -->
    <odometry
      x_multiplier="$f{1.0+0.02*randn()}"
      y_multiplier="$f{1.0+0.01*randn()}"
      yaw_multiplier="$f{1.0+0.03*randn()}"
    />

    <!--<friction class="wardiagnemma">
        <mu>0.7</mu>
        <C_damping>10</C_damping>
        <A_roll>50</A_roll>
        <R1>0.0075</R1>
        <R2>0.02</R2>
    </friction>-->

    <!--  Custom vehicle visualization model: the body, without the wheels -->
    <!-- 3D model filename to load (local or remote http://uri ) -->
    <visual>
        <model_uri>https://mrpt.github.io/mvsim-models/vehicle_pickup_v2.zip/vehicle_pickup/pickup_body.dae</model_uri>
        <model_yaw>-90.0</model_yaw>
        <model_roll>90.0</model_roll>
    </visual>

</vehicle:class>
